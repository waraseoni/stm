{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug (OpenOCD / ST-Link)",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "openocd",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/app.elf",
      "device": "STM32F103C8",
      "configFiles": [
        "interface/stlink.cfg",
        "target/stm32f1x.cfg"
      ],
      "openOCDLaunchCommands": [
        "adapter speed 1000"
      ],
      "runToEntryPoint": "main",
      "showDevDebugOutput": "none",
      "svdFile": ""
    },
    {
      "name": "Attach (OpenOCD / ST-Link)",
      "type": "cortex-debug",
      "request": "attach",
      "servertype": "openocd",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/app.elf",
      "device": "STM32F103C8",
      "configFiles": [
        "interface/stlink.cfg",
        "target/stm32f1x.cfg"
      ],
      "svdFile": ""
    }
  ]
}
