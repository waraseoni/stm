# ---------------------------------------------------------------------------
# stm32_project.cmake -- saare bare-metal projects ka ek hi build setup.
#
# Use (project ki CMakeLists.txt me):
#   include(../../common/cmake/stm32_project.cmake)
#   stm32_add_project(NAME app BOARD f103c8 SOURCES src/main.c)
#
# BOARD: f103c8 | f411re | f446re
#
# Jo cheezein automatic milti hain:
#   - CMSIS core + device headers (vendor/)
#   - startup .s + linker script + minimal system file (common/)
#   - app.elf / app.bin / app.hex + map + memory usage
#   - `flash` / `reset` / `size` targets (OpenOCD + ST-Link)
# ---------------------------------------------------------------------------

function(stm32_add_project)
  cmake_parse_arguments(P "" "NAME;BOARD" "SOURCES;DEFINES" ${ARGN})

  if(NOT P_NAME)
    set(P_NAME app)
  endif()
  if(NOT P_SOURCES)
    message(FATAL_ERROR "stm32_add_project: SOURCES khali hai")
  endif()

  set(_cmake_dir "${CMAKE_CURRENT_FUNCTION_LIST_DIR}")
  file(TO_CMAKE_PATH "${_cmake_dir}" _cmake_dir)
  get_filename_component(_common "${_cmake_dir}" DIRECTORY)   # stm32/common
  get_filename_component(_stm32  "${_common}" DIRECTORY)      # stm32
  get_filename_component(_root   "${_stm32}" DIRECTORY)       # workspace root
  set(_vendor "${_root}/vendor")

  if(P_BOARD STREQUAL "f103c8")
    set(_family f1)
    set(_def  STM32F103xB)
    set(_startup startup_stm32f103xb.s)
    set(_ld   STM32F103C8Tx.ld)
    set(_ocd  stm32f1x)
  elseif(P_BOARD STREQUAL "f411re")
    set(_family f4)
    set(_def  STM32F411xE)
    set(_startup startup_stm32f411xe.s)
    set(_ld   STM32F411RE.ld)
    set(_ocd  stm32f4x)
  elseif(P_BOARD STREQUAL "f446re")
    set(_family f4)
    set(_def  STM32F446xx)
    set(_startup startup_stm32f446xx.s)
    set(_ld   STM32F446RE.ld)
    set(_ocd  stm32f4x)
  else()
    message(FATAL_ERROR "Unknown BOARD '${P_BOARD}' (f103c8 | f411re | f446re)")
  endif()

  set(_device "${_vendor}/cmsis-device-${_family}")

  if(NOT EXISTS "${_device}/Include")
    message(FATAL_ERROR
      "CMSIS headers nahi mile: ${_device}\n"
      "Workspace root se chalayein:  .\\setup-vendor.ps1")
  endif()

  add_executable(${P_NAME}
    ${P_SOURCES}
    ${_common}/src/system_stm32${_family}xx.c
    ${_device}/Source/Templates/gcc/${_startup}
  )

  target_include_directories(${P_NAME} PRIVATE
    ${CMAKE_CURRENT_SOURCE_DIR}/src
    ${CMAKE_CURRENT_SOURCE_DIR}/include
    ${_vendor}/cmsis-core/Include
    ${_device}/Include
  )

  target_compile_definitions(${P_NAME} PRIVATE ${_def} ${P_DEFINES})

  target_compile_options(${P_NAME} PRIVATE
    -Wall -Wextra
    -Wno-unused-parameter
  )

  target_link_options(${P_NAME} PRIVATE
    -T${_common}/ld/${_ld}
    --specs=nano.specs
    --specs=nosys.specs
    -Wl,--gc-sections
    -Wl,-Map=${CMAKE_BINARY_DIR}/${P_NAME}.map
    -Wl,--print-memory-usage
  )

  add_custom_command(TARGET ${P_NAME} POST_BUILD
    COMMAND ${CMAKE_OBJCOPY} -O binary $<TARGET_FILE:${P_NAME}> ${CMAKE_BINARY_DIR}/${P_NAME}.bin
    COMMAND ${CMAKE_OBJCOPY} -O ihex   $<TARGET_FILE:${P_NAME}> ${CMAKE_BINARY_DIR}/${P_NAME}.hex
    COMMAND ${CMAKE_SIZE} $<TARGET_FILE:${P_NAME}>
    COMMENT "objcopy -> ${P_NAME}.bin / ${P_NAME}.hex"
  )

  # --- OpenOCD config (build/ me generate hota hai) -------------------------
  set(_ocdcfg "${CMAKE_BINARY_DIR}/openocd.cfg")
  file(WRITE "${_ocdcfg}"
"# auto-generated by stm32_project.cmake -- board: ${P_BOARD}
source [find interface/stlink.cfg]
source [find target/${_ocd}.cfg]
adapter speed 2000
")

  set(_elf "${CMAKE_BINARY_DIR}/${P_NAME}.elf")
  file(TO_CMAKE_PATH "${_elf}" _elf)

  find_program(OPENOCD_EXE openocd)
  if(OPENOCD_EXE)
    add_custom_target(flash
      COMMAND ${OPENOCD_EXE} -f ${_ocdcfg}
              -c "program \"${_elf}\" verify reset exit"
      DEPENDS ${P_NAME}
      COMMENT "OpenOCD: flash ${P_NAME}.elf"
      VERBATIM)

    add_custom_target(reset
      COMMAND ${OPENOCD_EXE} -f ${_ocdcfg} -c "init; reset run; shutdown"
      COMMENT "OpenOCD: reset target"
      VERBATIM)
  else()
    message(STATUS "openocd nahi mila -- 'flash'/'reset' targets skip")
  endif()

  add_custom_target(size
    COMMAND ${CMAKE_SIZE} -A ${_elf}
    COMMENT "Section sizes"
    VERBATIM)
endfunction()
