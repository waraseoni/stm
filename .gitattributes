# Line endings: tools (make, gcc, openocd) LF pasand karte hain, PowerShell CRLF.
* text=auto

*.c      text eol=lf
*.h      text eol=lf
*.s      text eol=lf
*.S      text eol=lf
*.ld     text eol=lf
Makefile text eol=lf
*.mk     text eol=lf
*.cmake  text eol=lf
CMakeLists.txt text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.ps1    text eol=crlf

*.pdf binary
*.bin binary
*.elf binary
